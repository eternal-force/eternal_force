# 複製這個檔案為 .env，並依實際環境修改。.env 不會被提交到版本控制。

FLASK_ENV=development

# 用來簽署 session cookie 與 CSRF token，正式環境務必換成隨機長字串，
# 例如：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-in-production

# 本機 PostgreSQL 連線字串範例（依你的本機安裝調整帳號/密碼/資料庫名稱）
# 先手動建立資料庫：createdb eternal_force
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/eternal_force

# 正式環境（部署在 HTTPS 之後）建議設為 true，強制 session cookie 只在 HTTPS 傳送
SESSION_COOKIE_SECURE=false
